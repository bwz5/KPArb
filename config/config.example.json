{
  "environment": {
    "file": ".env",
    "kalshiKeyIdentifierVariable": "KALSHI_API_KEY_ID",
    "kalshiPrivateKeyVariable": "KALSHI_PRIVATE_KEY",
    "kalshiPrivateKeyPathVariable": "KALSHI_PRIVATE_KEY_PATH",
    "languageModelApiKeyVariable": "KPARB_LLM_API_KEY"
  },
  "kalshi": {
    "restBaseUrl": "https://api.elections.kalshi.com/trade-api/v2",
    "webSocketUrl": "wss://api.elections.kalshi.com/trade-api/ws/v2",
    "pageLimit": 1000,
    "maximumPages": 500,
    "excludeMultivariateMarkets": true,
    "tickersPerSubscription": 100,
    "takerFeeRate": 0.07
  },
  "polymarket": {
    "gammaBaseUrl": "https://gamma-api.polymarket.com",
    "webSocketUrl": "wss://ws-subscriptions-clob.polymarket.com/ws/market",
    "pageLimit": 100,
    "maximumPages": 2000,
    "tokensPerSubscription": 500,
    "textPingIntervalSeconds": 10
  },
  "languageModel": {
    "baseUrl": "https://api.groq.com/openai/v1",
    "model": "openai/gpt-oss-120b",
    "fallbackModels": ["openai/gpt-oss-20b", "qwen/qwen3.8-27b"],
    "requestsPerMinute": 250,
    "maximumAttempts": 6,
    "maximumOutputTokens": 400,
    "reasoningEffort": "low",
    "requestJsonObject": false,
    "maximumRetryAfterSeconds": 120
  },
  "discovery": {
    "maximumDaysUntilResolution": 2,
    "kalshiCloseTimeSearchDays": 21,
    "polymarketMoneylineSearchDays": 10,
    "rematchIntervalMinutes": 60,
    "pairsBeforeStreaming": 500,
    "maximumMinutesBeforeStreaming": 5,
    "pairsBetweenStreamRestarts": 25
  },
  "matching": {
    "candidatesPerMarket": 3,
    "candidatesPerPolymarketMarket": 3,
    "requireCompatibleMarketTypes": true,
    "requireMatchingStrikes": true,
    "minimumSimilarity": 0.45,
    "maximumCloseTimeDifferenceDays": 2,
    "requireCompatibleNumbers": true,
    "minimumConfidence": 0.85,
    "maximumLanguageModelRequests": 20000,
    "concurrentRequests": 8,
    "maximumRulesCharacters": 800,
    "maximumConsecutiveFailures": 5,
    "maximumQuotaWaitSeconds": 900,
    "cachePath": "data/match_cache.json",
    "manualMatchesPath": "data/manual_matches.json",
    "matchedPairsPath": "data/matched_pairs.json",
    "entitiesPath": "config/entities.json",
    "sharedTeamBonus": 0.25,
    "excludedKalshiTickerPrefixes": ["KXCS2", "KXDOTA2", "KXCODGAME", "KXR6GAME", "KXLOL", "KXVALORANT"],
    "defaultNoResultProbability": 0.005,
    "noResultProbabilityByKalshiPrefix": {"KXATP": 0.02, "KXWTA": 0.02, "KXITF": 0.03}
  },
  "arbitrage": {
    "minimumEdgeTicks": 5,
    "maximumQuoteAgeMilliseconds": 0,
    "maximumDepthLevels": 32,
    "statsIntervalSeconds": 10,
    "maximumPairs": 5000
  },
  "execution": {
    "mode": "disabled",
    "maximumDollarsPerTrade": 10,
    "maximumContractsPerTrade": 100,
    "maximumDollarsPerPair": 50,
    "kalshiBudgetDollars": 250,
    "polymarketBudgetDollars": 250,
    "rebalanceHours": 24,
    "maximumLossDollars": 25,
    "killSwitchPath": "data/KILL",
    "journalPath": "data/executions.jsonl",
    "maximumSignalAgeMilliseconds": 500,
    "firstLeg": "thinner",
    "chaseTicks": 5,
    "unwindSlippageTicks": 20
  },
  "logging": {
    "directory": "data/logs",
    "printFeedEvents": true,
    "printEngineStats": true
  }
}
